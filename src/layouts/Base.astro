---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'เว็บไซต์ส่วนตัว แนะนำตัว และผลงาน' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: `${base}/work/`, label: 'ผลงาน', match: `${base}/work` },
  { href: `${base}/about/`, label: 'เกี่ยวกับ', match: `${base}/about` },
  { href: `${base}/contact/`, label: 'ติดต่อ', match: `${base}/contact` },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05060f" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <canvas id="bg" aria-hidden="true"></canvas>
    <div class="aurora" aria-hidden="true"></div>
    <div class="grid-floor" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href={`${base}/`}><span class="brand-mark">&lt;/&gt;</span> ลิก</a>
      <nav>
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.match) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} สหรัฐ ยกทวน</span>
      <span class="muted">สร้างด้วย Astro · host บน GitHub Pages</span>
    </footer>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ---------- เครือข่ายโหนดเป็นพื้นหลัง ---------- */
        var c = document.getElementById('bg');
        if (c && c.getContext) {
          var ctx = c.getContext('2d');
          var w = 0, h = 0, nodes = [];
          var mouse = { x: -9999, y: -9999 };
          var running = false;

          function resize() {
            var dpr = Math.min(window.devicePixelRatio || 1, 2);
            w = window.innerWidth; h = window.innerHeight;
            c.width = w * dpr; c.height = h * dpr;
            c.style.width = w + 'px'; c.style.height = h + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            var n = Math.min(90, Math.floor((w * h) / 17000));
            nodes = [];
            for (var i = 0; i < n; i++) {
              nodes.push({
                x: Math.random() * w, y: Math.random() * h,
                vx: (Math.random() - 0.5) * 0.28, vy: (Math.random() - 0.5) * 0.28
              });
            }
          }

          function frame() {
            ctx.clearRect(0, 0, w, h);
            for (var i = 0; i < nodes.length; i++) {
              var a = nodes[i];
              if (!reduce) {
                a.x += a.vx; a.y += a.vy;
                if (a.x < 0 || a.x > w) a.vx *= -1;
                if (a.y < 0 || a.y > h) a.vy *= -1;
              }
              ctx.fillStyle = 'rgba(120, 220, 255, 0.7)';
              ctx.beginPath(); ctx.arc(a.x, a.y, 1.4, 0, 6.2832); ctx.fill();
              for (var j = i + 1; j < nodes.length; j++) {
                var b = nodes[j];
                var dx = a.x - b.x, dy = a.y - b.y, d = Math.sqrt(dx * dx + dy * dy);
                if (d < 130) {
                  ctx.strokeStyle = 'rgba(0, 229, 255,' + (0.16 * (1 - d / 130)).toFixed(3) + ')';
                  ctx.lineWidth = 1;
                  ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
                }
              }
              var mx = a.x - mouse.x, my = a.y - mouse.y, md = Math.sqrt(mx * mx + my * my);
              if (md < 170) {
                ctx.strokeStyle = 'rgba(190, 120, 255,' + (0.55 * (1 - md / 170)).toFixed(3) + ')';
                ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
              }
            }
            if (running && !reduce) requestAnimationFrame(frame);
          }

          function start() {
            if (running) return;
            running = true;
            frame();
          }
          resize(); frame();
          if (!reduce) start();
          window.addEventListener('resize', function () { resize(); frame(); });
          window.addEventListener('pointermove', function (e) { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
          window.addEventListener('pointerleave', function () { mouse.x = mouse.y = -9999; });
          document.addEventListener('visibilitychange', function () {
            if (document.hidden) { running = false; } else if (!reduce) { start(); }
          });
        }

        /* ---------- แสงตามเมาส์บนการ์ด ---------- */
        document.addEventListener('pointermove', function (e) {
          var cards = document.querySelectorAll('.card');
          for (var i = 0; i < cards.length; i++) {
            var r = cards[i].getBoundingClientRect();
            cards[i].style.setProperty('--mx', (e.clientX - r.left) + 'px');
            cards[i].style.setProperty('--my', (e.clientY - r.top) + 'px');
          }
        }, { passive: true });

        /* ---------- ภาพค่อยๆ ปรากฏตอนเลื่อน ---------- */
        var items = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window && !reduce) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
            });
          }, { threshold: 0.12 });
          items.forEach(function (el, i) {
            el.style.transitionDelay = ((i % 6) * 60) + 'ms';
            io.observe(el);
          });
        } else {
          items.forEach(function (el) { el.classList.add('in'); });
        }

        /* ---------- แถบความคืบหน้าการเลื่อน ---------- */
        var bar = document.getElementById('progress');
        if (bar) {
          var onScroll = function () {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.transform = 'scaleX(' + (max > 0 ? window.scrollY / max : 0) + ')';
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }

        /* ---------- ข้อความพิมพ์วน ---------- */
        var typed = document.querySelector('.typed');
        if (typed && !reduce) {
          var words = [];
          try { words = JSON.parse(typed.getAttribute('data-words') || '[]'); } catch (e) {}
          if (words.length > 1) {
            var wi = 0, ci = words[0].length, del = true;
            (function tick() {
              var word = words[wi];
              if (del) { ci--; } else { ci++; }
              typed.textContent = word.slice(0, ci);
              var delay = del ? 35 : 75;
              if (!del && ci === word.length) { del = true; delay = 1600; }
              else if (del && ci === 0) { del = false; wi = (wi + 1) % words.length; delay = 350; }
              setTimeout(tick, delay);
            })();
          }
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #05060f;
    --fg: #e8ecff;
    --muted: #98a0c8;
    --line: rgba(255, 255, 255, 0.09);
    --glass: rgba(255, 255, 255, 0.045);
    --c1: #00e5ff;
    --c2: #8a5cff;
    --c3: #ff3df2;
    --radius: 1rem;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; color-scheme: dark; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Noto Sans Thai', 'Segoe UI', sans-serif;
    line-height: 1.75;
    min-height: 100vh;
    overflow-x: hidden;
  }
  ::selection { background: rgba(138, 92, 255, 0.45); }
  a { color: var(--c1); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--c1); outline-offset: 3px; border-radius: 4px; }

  /* พื้นหลัง */
  #bg { position: fixed; inset: 0; z-index: -3; pointer-events: none; }
  .aurora {
    position: fixed; inset: -20%; z-index: -2; pointer-events: none;
    background:
      radial-gradient(40% 40% at 20% 25%, rgba(138, 92, 255, 0.28), transparent 70%),
      radial-gradient(35% 35% at 80% 20%, rgba(0, 229, 255, 0.2), transparent 70%),
      radial-gradient(40% 40% at 60% 85%, rgba(255, 61, 242, 0.16), transparent 70%);
    filter: blur(40px);
    animation: drift 22s ease-in-out infinite alternate;
  }
  .grid-floor {
    position: fixed; left: 0; right: 0; bottom: 0; height: 45vh; z-index: -2; pointer-events: none;
    background-image:
      linear-gradient(rgba(0, 229, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 229, 255, 0.12) 1px, transparent 1px);
    background-size: 48px 48px;
    transform: perspective(500px) rotateX(62deg);
    transform-origin: bottom;
    -webkit-mask-image: linear-gradient(to top, #000, transparent 85%);
    mask-image: linear-gradient(to top, #000, transparent 85%);
    opacity: 0.55;
  }
  .progress {
    position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 50;
    background: linear-gradient(90deg, var(--c1), var(--c2), var(--c3));
    transform: scaleX(0); transform-origin: left;
    box-shadow: 0 0 12px var(--c1);
  }

  /* โครงหน้า */
  .site-header, main, .site-footer { max-width: 62rem; margin: 0 auto; padding-left: 1.25rem; padding-right: 1.25rem; }
  main { padding-top: 2rem; padding-bottom: 2rem; }
  .site-header {
    position: sticky; top: 0.75rem; z-index: 40;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;
    margin-top: 0.75rem; padding: 0.6rem 1.1rem;
    background: rgba(8, 10, 24, 0.6);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border: 1px solid var(--line); border-radius: 999px;
    max-width: calc(62rem - 0px);
  }
  .brand { font-weight: 800; font-size: 1.15rem; color: var(--fg); letter-spacing: 0.02em; }
  .brand:hover { text-decoration: none; }
  .brand-mark { color: var(--c1); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; text-shadow: 0 0 10px var(--c1); }
  nav { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  nav a {
    color: var(--muted); padding: 0.3rem 0.85rem; border-radius: 999px; transition: all 0.2s;
  }
  nav a:hover { color: var(--fg); text-decoration: none; background: rgba(255, 255, 255, 0.06); }
  nav a[aria-current='page'] { color: var(--fg); background: rgba(0, 229, 255, 0.12); box-shadow: inset 0 0 0 1px rgba(0, 229, 255, 0.35), 0 0 14px rgba(0, 229, 255, 0.2); }
  .site-footer {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    color: var(--muted); font-size: 0.9rem; border-top: 1px solid var(--line);
    padding-top: 1.25rem; padding-bottom: 2rem; margin-top: 3rem;
  }

  /* ตัวอักษร */
  h1 { font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1.2; margin: 0.4rem 0 1rem; letter-spacing: -0.01em; }
  h2 { font-size: 1.5rem; margin: 2.5rem 0 1rem; display: flex; align-items: center; gap: 0.6rem; }
  h2::before { content: ''; width: 0.5rem; height: 1.3rem; border-radius: 3px; background: linear-gradient(var(--c1), var(--c2)); box-shadow: 0 0 12px var(--c1); }
  p { margin: 0.5rem 0 1rem; }
  .muted { color: var(--muted); }
  .grad {
    background: linear-gradient(90deg, var(--c1), var(--c2), var(--c3), var(--c1));
    background-size: 250% auto;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: shine 7s linear infinite;
  }

  /* hero */
  .hero { padding: 2.5rem 0 1rem; }
  .badge {
    display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.3rem 0.9rem;
    border: 1px solid rgba(0, 229, 255, 0.3); border-radius: 999px; background: rgba(0, 229, 255, 0.07);
    font-size: 0.9rem; color: #bff6ff; margin: 0;
  }
  .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: #39ff88; box-shadow: 0 0 10px #39ff88; animation: pulse 1.8s ease-in-out infinite; }
  .lead { font-size: clamp(1.05rem, 2.6vw, 1.35rem); color: var(--fg); margin-top: 0; }
  .typed { color: var(--c1); text-shadow: 0 0 14px rgba(0, 229, 255, 0.6); font-weight: 600; }
  .caret { display: inline-block; width: 2px; height: 1.1em; background: var(--c1); margin-left: 3px; vertical-align: -0.15em; animation: blink 1s steps(2) infinite; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.5rem 0 0; }
  .btn {
    display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; font-weight: 600;
    border: 1px solid var(--line); color: var(--fg); background: var(--glass); transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn:hover { text-decoration: none; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0, 229, 255, 0.22); }
  .btn.primary { color: #04101a; border: none; background: linear-gradient(90deg, var(--c1), var(--c2)); box-shadow: 0 0 24px rgba(0, 229, 255, 0.35); }
  .stats { display: flex; flex-wrap: wrap; gap: 0.9rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .stats li { padding: 0.6rem 1.1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--glass); }
  .stats b { display: block; font-size: 1.6rem; line-height: 1.2; color: var(--c1); text-shadow: 0 0 12px rgba(0, 229, 255, 0.5); }
  .stats span { color: var(--muted); font-size: 0.85rem; }

  /* การ์ด */
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); padding: 0; margin: 0; list-style: none; }
  .card {
    position: relative; overflow: hidden; padding: 1.25rem; border-radius: var(--radius);
    background: var(--glass); border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .card::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.3s;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgba(0, 229, 255, 0.2), transparent 70%);
  }
  .card:hover { transform: translateY(-5px); border-color: rgba(0, 229, 255, 0.45); box-shadow: 0 12px 40px rgba(0, 229, 255, 0.15), 0 0 0 1px rgba(138, 92, 255, 0.25); }
  .card:hover::before { opacity: 1; }
  .card h3 { margin: 0.35rem 0; font-size: 1.2rem; }
  .card h3 a { color: var(--fg); }
  .card h3 a::after { content: ''; position: absolute; inset: 0; } /* ทั้งการ์ดกดได้ */
  .card p { color: var(--muted); font-size: 0.95rem; margin: 0.4rem 0 0.8rem; }
  .tag { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c2); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; list-style: none; }
  .chip, .chips li {
    padding: 0.2rem 0.7rem; border-radius: 999px; font-size: 0.82rem; color: #cfe9ff;
    border: 1px solid rgba(138, 92, 255, 0.35); background: rgba(138, 92, 255, 0.1);
  }
  .chips li a { color: inherit; }
  .chips.big li { font-size: 0.95rem; padding: 0.4rem 1rem; transition: all 0.2s; }
  .chips.big li:hover { border-color: var(--c1); background: rgba(0, 229, 255, 0.12); box-shadow: 0 0 18px rgba(0, 229, 255, 0.25); transform: translateY(-2px); }
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .panel { padding: 1.25rem 1.5rem; border-radius: var(--radius); background: var(--glass); border: 1px solid var(--line); }
  .panel p:first-child { margin-top: 0; }
  .panel p:last-child { margin-bottom: 0; }

  /* ปรากฏตอนเลื่อน (เฉพาะเมื่อมี JS) */
  .js .reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .js .reveal.in { opacity: 1; transform: none; }

  @keyframes shine { to { background-position: 250% center; } }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes pulse { 50% { transform: scale(1.5); opacity: 0.6; } }
  @keyframes drift { to { transform: translate3d(4%, 3%, 0) scale(1.08); } }

  @media (max-width: 40rem) {
    .site-header { border-radius: 1.25rem; }
    .grid-floor { height: 30vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
    .js .reveal { opacity: 1; transform: none; }
  }
</style>
