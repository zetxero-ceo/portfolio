---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { works } from '../data/work';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="ลิก | เว็บไซต์ส่วนตัว">
  <section>
    <h1>สวัสดีครับ ผมลิก</h1>
    <p>ข้อความแนะนำตัวสั้นๆ (ตัวอย่าง) — ผมทำงานด้านดีไซน์ โค้ด และวิดีโอ</p>
    <p><a href={`${base}/about/`}>รู้จักผมมากขึ้น</a> · <a href={`${base}/contact/`}>ติดต่อ</a></p>
  </section>
  <section>
    <h2>ผลงานเด่น</h2>
    <ul class="grid">
      {works.slice(0, 6).map((w) => <WorkCard work={w} />)}
    </ul>
    <p><a href={`${base}/work/`}>ดูผลงานทั้งหมด →</a></p>
  </section>
</Base>
