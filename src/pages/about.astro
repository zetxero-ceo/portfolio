---
import Base from '../layouts/Base.astro';
import { works } from '../data/work';
// รวมเทคโนโลยีจากผลงานจริง (ไม่ซ้ำ)
const tech = [...new Set(works.flatMap((w) => w.tech))];
---
<Base title="เกี่ยวกับ | สหรัฐ ยกทวน (ลิก)">
  <h1>เกี่ยวกับผม</h1>
  <p>
    ผมชื่อ <strong>สหรัฐ ยกทวน</strong> ชื่อเล่น <strong>ลิก</strong> อายุ 22 ปี คนไทย
    เป็นนักเขียนโค้ดฝึกหัด กำลังเรียนรู้ Python และ AI และเปิดรับโอกาสนักพัฒนาระดับจูเนียร์
  </p>
  <h2>งานอดิเรก</h2>
  <p>เขียนโค้ด อ่านหนังสือ เล่นเกม</p>
  <h2>คติประจำใจ</h2>
  <p>อย่ายอมแพ้</p>
  <h2>เทคโนโลยีที่ใช้ในผลงาน</h2>
  <p>{tech.join(' · ')}</p>
</Base>
