---
import Base from '../../layouts/Base.astro';
import { works, categoryLabel } from '../../data/work';
export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${work.title} | ลิก`} description={work.summary}>
  <p><a href={`${base}/work/`}>← ผลงานทั้งหมด</a></p>
  <span class="tag">{categoryLabel[work.category]}</span>
  <h1>{work.title}</h1>
  <p>{work.summary}</p>
  {work.youtubeId && (
    <div class="video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${work.youtubeId}`}
        title={work.title}
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
  )}
  <h2>บทบาทของผม</h2>
  <p>{work.role}</p>
  <h2>เทคโนโลยี</h2>
  <p>{work.tech.join(' · ')}</p>
  <h2>ลิงก์</h2>
  <ul>
    {work.liveUrl && <li><a href={work.liveUrl} target="_blank" rel="noopener noreferrer">ดูเว็บจริง</a></li>}
    <li><a href={work.repo} target="_blank" rel="noopener noreferrer">โค้ดบน GitHub</a></li>
  </ul>
</Base>
