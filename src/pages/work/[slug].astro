---
import Base from '../../layouts/Base.astro';
import { works, categoryLabel } from '../../data/work';
export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${work.title} | ลิก`} description={work.summary}>
  <p><a href={`${base}/work/`}>← ผลงานทั้งหมด</a></p>
  <span class="tag">{categoryLabel[work.category]}</span>
  <h1>{work.title}</h1>
  <p class="muted">{work.summary}</p>
  {work.youtubeId && (
    <div class="video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${work.youtubeId}`}
        title={work.title}
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
  )}
  <h2>โจทย์</h2><p>{work.problem}</p>
  <h2>กระบวนการ</h2><p>{work.process}</p>
  <h2>ผลลัพธ์</h2><p>{work.result}</p>
  {work.links && (
    <ul>{work.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  )}
</Base>
