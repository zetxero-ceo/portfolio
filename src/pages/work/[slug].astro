---
import Base from '../../layouts/Base.astro';
import { works, categoryLabel } from '../../data/work';
export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${work.title} | ลิก`} description={work.summary}>
  <p><a href={`${base}/work/`}>← ผลงานทั้งหมด</a></p>
  <span class="tag">{categoryLabel[work.category]}</span>
  <h1><span class="grad">{work.title}</span></h1>
  <p class="lead">{work.summary}</p>
  {work.youtubeId && (
    <div class="video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${work.youtubeId}`}
        title={work.title}
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
  )}
  <h2>บทบาทของผม</h2>
  <div class="panel reveal"><p>{work.role}</p></div>
  <h2>เทคโนโลยี</h2>
  <ul class="chips big reveal">{work.tech.map((t) => <li>{t}</li>)}</ul>
  <h2>ลิงก์</h2>
  <div class="actions reveal">
    {work.liveUrl && <a class="btn primary" href={work.liveUrl} target="_blank" rel="noopener noreferrer">ดูเว็บจริง</a>}
    <a class="btn" href={work.repo} target="_blank" rel="noopener noreferrer">โค้ดบน GitHub</a>
  </div>
</Base>
