---
import { categoryLabel, type Work } from '../data/work';
const { work } = Astro.props as { work: Work };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<li class="card reveal">
  <span class="tag">{categoryLabel[work.category]}{work.liveUrl ? ' · LIVE' : ''}</span>
  <h3><a href={`${base}/work/${work.slug}/`}>{work.title}</a></h3>
  <p>{work.summary}</p>
  <ul class="chips" aria-label="เทคโนโลยี">
    {work.tech.slice(0, 3).map((t) => <li>{t}</li>)}
  </ul>
</li>
