---
import { categoryLabel, type Work } from '../data/work';
const { work } = Astro.props as { work: Work };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<li class="card">
  <span class="tag">{categoryLabel[work.category]}</span>
  <h3><a href={`${base}/work/${work.slug}/`}>{work.title}</a></h3>
  <p class="muted">{work.summary}</p>
</li>
